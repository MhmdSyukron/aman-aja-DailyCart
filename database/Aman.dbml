Table "rekening" {
  id int [pk, increment]
  nama varchar(255)
  nomor varchar(255)
  saldo decimal(10,2)
  created_at timestamp
  updated_at timestamp
}
Table "transaksi" {
  id int [pk, increment]
  rekening_id int [ref: > rekening.id]
  tipe enum('debit', 'kredit')
  jumlah decimal(10,2)
  created_at timestamp
  updated_at timestamp
}

Table "nama_pelanggan"{
  "id_pelanggan" int [pk, ref: > pelanggan.id_pelanggan]
  "nama_depan" string(50)
  "nama_tengah" string(50)
  "nama_belakang" string(50)
}


Table "pelanggan"{
  "id_pelanggan" int [pk, increment]
  "alamat" string(100)
  "no_hp" string(15)
  "email" string(50)
  "tanggal_lahir" date
  "jenis_kelamin" enum('L', 'P')
}